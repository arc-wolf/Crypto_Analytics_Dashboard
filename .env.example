# Copy to .env and replace placeholders with unique secrets.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
INFLUXDB_ORG=crypto_org
INFLUXDB_BUCKET=crypto_bucket
# Generate a unique token; do not reuse this example value.
INFLUXDB_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_STRONG_UNIQUE_PASSWORD
